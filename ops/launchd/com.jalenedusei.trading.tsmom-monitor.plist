<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Monthly regime monitor (Trial 07's forward role), at 06:00 local on days 1 to 5. launchd calendar times
     are local, so 06:00 on the 1st lands after the UTC month end in any US time zone; the repeats catch a Mac
     that was off on the 1st (the run is idempotent). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jalenedusei.trading.tsmom-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd __ROOT__ || exit 1; __NPM__ run tsmom:monitor &gt;&gt; data/monitor.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Day</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Day</key>
      <integer>2</integer>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Day</key>
      <integer>3</integer>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Day</key>
      <integer>4</integer>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Day</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/monitor-launchd.err.log</string>
</dict>
</plist>
