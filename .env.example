# Copy to .env to override defaults (cp .env.example .env). Never commit .env.
# Every variable is optional. With no .env the bot runs the BTCUSDT 5m
# crossover in local simulation on public Binance data, and needs no keys.
# Values here are the code defaults unless noted.

# --- Universe and strategy ---
# SYMBOLS takes a comma list or a named universe: @book, @book-crypto,
# @book-stocks, @trial07 (see src/universe.ts).
SYMBOL=BTCUSDT
# SYMBOLS=@book
INTERVAL=5m
# STRATEGY: sma-cross (rejected, Trials 01-02), donchian-breakout (rejected,
# Trial 03) or tsmom (Trials 04-08).
STRATEGY=sma-cross
FAST_MA=9
SLOW_MA=21
TSMOM_LOOKBACK=28
# TSMOM_STATE=on is the Trial 07 construction: long while momentum is
# positive. It needs EXECUTION=alpaca-paper and LONG_ONLY=on.
TSMOM_STATE=off
LONG_ONLY=off

# --- Scoring ---
REPLAY_CANDLES=500
EVAL_HORIZON=12
# Round-trip cost in bps for replays and simulated rows.
FEE_BPS=30
# Round-trip cost for the book's real paper rows, per sleeve. Crypto measures
# about 52 bps on this account (0.25% taker fee per side plus about 1 bp of
# slippage per side, `npm run report`). Stocks pay no commission; 10 is an
# allowance for spread, not a measurement.
FEE_BPS_CRYPTO=60
FEE_BPS_STOCKS=10
SCAN_CANDLES=120
MEMORY_MIN_LOSSES=2

# --- Execution (Alpaca PAPER only; the order host is hardcoded to paper) ---
# sim: local simulation. alpaca-paper: real orders on the paper account.
EXECUTION=sim
BUDGET=100000
PER_TRADE_USD=2000
MAX_OPEN_POSITIONS=50
# Bounded marketable limit: cap the fill this many bps above the quoted ask
# (0 = plain market order).
LIMIT_SLIPPAGE_BPS=0
# Skip a crypto entry when Alpaca's quoted spread is wider than this (0 = no
# check). Stock entries never skip on spread: IEX's quote is one venue.
MAX_SPREAD_BPS=100
# Cancel an order that has not filled after this many seconds.
ORDER_TIMEOUT_SEC=30
# New crypto entries only within N minutes after the 00:00 UTC close (0 = any time).
ENTRY_WINDOW_MIN=0
# taker (default) or maker. Alpaca paper fills resting limits at the maker
# rate but has no queue, so it flatters maker orders.
ORDER_MODE=taker
# Symbols that take no new entries but keep exiting on the strategy's rule,
# to wind a sleeve down (for example @book-stocks). Empty by default.
# ENTRY_SKIP=

# --- Risk controls (src/portfolioRisk.ts) ---
MAX_DAILY_LOSS_PCT=8
VOL_TARGET_PCT=4
VOL_SIZE_FLOOR=0.25
CRYPTO_CLUSTER_CAP_PCT=70
MAX_POSITION_LOSS_PCT=30

# --- Operations ---
# Where the ledger, heartbeats and reports live.
DATA_DIR=data
# Heartbeat name for this run (data/heartbeat/<label>.json); the launchd
# plists set book, watch-flip and watch-sol. Empty means a name built from
# the strategy, interval, execution mode and symbol count.
# RUN_LABEL=
# Run locks (one book scan at a time per broker account, across checkouts).
# Default ~/.cache/trading-harness/locks.
# LOCK_DIR=
# Local dashboard port (npm run dashboard).
DASH_PORT=8787

# --- Alpaca PAPER keys ---
# Needed for stock data, EXECUTION=alpaca-paper, report, reconcile and
# health. Paper keys only: never live keys, never pasted into chat, never
# committed.
# ALPACA_PAPER_KEY_ID=
# ALPACA_PAPER_SECRET=
