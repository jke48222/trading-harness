# Copy to .env to override defaults (cp .env.example .env). Never commit .env.
# Every variable is optional — the bot runs on safe paper defaults with no .env at all.

# --- Market / strategy ---
SYMBOL=BTCUSDT
INTERVAL=5m
FAST_MA=9
SLOW_MA=21

# --- Risk (paper units of the base asset, e.g. BTC) ---
QUANTITY=0.001
MAX_POSITION=0.003

# --- Replay / scoring ---
REPLAY_CANDLES=500
EVAL_HORIZON=12
FEE_BPS=10
SCAN_CANDLES=120

# --- Memory ---
MEMORY_MIN_LOSSES=2

# --- Alpaca PAPER keys (read ONLY by the read-only broker adapter) ---
# Used by `npm run broker:check` (GET-only smoke test). There is intentionally
# NO order-submitting code path in this project; the paper host is hardcoded.
# Paper keys only — never live keys, never pasted into chat, never committed.
# ALPACA_PAPER_KEY_ID=
# ALPACA_PAPER_SECRET=
