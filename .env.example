# Copy to .env to override defaults (cp .env.example .env). Never commit .env.
# Every variable is optional. With no .env the bot runs the BTCUSDT 5m
# crossover in local simulation on public Binance data, and needs no keys.
# Values here are the code defaults unless noted.

# --- Universe and strategy ---
# SYMBOLS takes a comma list or a named universe: @book, @book-crypto,
# @book-stocks, @trial07 (see src/universe.ts).
SYMBOL=BTCUSDT
# SYMBOLS=@book
INTERVAL=5m
# STRATEGY: sma-cross (rejected, Trials 01-02), donchian-breakout (rejected,
# Trial 03) or tsmom (Trials 04-08).
STRATEGY=sma-cross
FAST_MA=9
SLOW_MA=21
TSMOM_LOOKBACK=28
# TSMOM_STATE=on is the Trial 07 construction: long while momentum is
# positive. It needs EXECUTION=alpaca-paper and LONG_ONLY=on.
TSMOM_STATE=off
# The state rule as a vote (Trial 09): buy when at least TSMOM_ENTER_VOTES of
# TSMOM_LOOKBACKS are positive, sell at TSMOM_EXIT_VOTES or fewer, hold in
# between. Unset, the rule is TSMOM_LOOKBACK alone. The book uses 7,14,28,56,
# entering at 3 and exiting at 1.
# TSMOM_LOOKBACKS=
# TSMOM_ENTER_VOTES=
# TSMOM_EXIT_VOTES=
LONG_ONLY=off

# --- Scoring ---
REPLAY_CANDLES=500
EVAL_HORIZON=12
# Round-trip cost in bps for replays and simulated rows.
FEE_BPS=30
# Round-trip cost for the book's real paper rows, per sleeve. Crypto measures
# about 52 bps on this account (0.25% taker fee per side plus about 1 bp of
# slippage per side, `npm run report`). Stocks pay no commission; 10 is an
# allowance for spread, not a measurement.
FEE_BPS_CRYPTO=60
FEE_BPS_STOCKS=10
SCAN_CANDLES=120
MEMORY_MIN_LOSSES=2

# --- Execution (Alpaca PAPER only; the order host is hardcoded to paper) ---
# sim: local simulation. alpaca-paper: real orders on the paper account.
EXECUTION=sim
BUDGET=100000
PER_TRADE_USD=2000
MAX_OPEN_POSITIONS=50
# Bounded marketable limit: cap the fill this many bps above the quoted ask
# (0 = plain market order).
LIMIT_SLIPPAGE_BPS=0
# Skip a crypto entry when Alpaca's quoted spread is wider than this (0 = no
# check). Stock entries never skip on spread: IEX's quote is one venue.
MAX_SPREAD_BPS=100
# Cancel an order that has not filled after this many seconds.
ORDER_TIMEOUT_SEC=30
# New crypto entries only within N minutes after the 00:00 UTC close (0 = any time).
ENTRY_WINDOW_MIN=0
# taker (default) or maker. Alpaca paper fills resting limits at the maker
# rate but has no queue, so it flatters maker orders.
ORDER_MODE=taker
# Maker mode only: rest the limit this many bps below the mark, and cancel
# it after this many seconds without a fill.
MAKER_OFFSET_BPS=5
MAKER_WAIT_SEC=25
# Fixed sizes for simulated trades and replays (EXECUTION=sim): base units
# for crypto, shares for stocks, and the most one position may hold.
QUANTITY=0.001
MAX_POSITION=0.003
STOCK_QUANTITY=1
STOCK_MAX_POSITION=3
# Symbols that take no new entries but keep exiting on the strategy's rule.
# Use it to wind a sleeve down (for example @book-stocks) or to keep the
# book off a pair the paper simulator never fills. Empty by default.
# ENTRY_SKIP=

# --- Risk controls (src/portfolioRisk.ts) ---
MAX_DAILY_LOSS_PCT=8
VOL_TARGET_PCT=4
VOL_SIZE_FLOOR=0.25
CRYPTO_CLUSTER_CAP_PCT=70
MAX_POSITION_LOSS_PCT=30

# --- Research settings for the rejected strategies (their trials reproduce) ---
# Trial 02: the 1h trend filter on the 9/21 cross.
REGIME_FILTER=off
HTF_INTERVAL=1h
HTF_MA=50
# Trial 03: Donchian channel length, and its same-timeframe trend gate.
DONCHIAN_LEN=20
TREND_ALIGN=off
TREND_MA=200
# Replay window bounds (ISO dates) for in-sample and out-of-sample splits;
# empty means the whole span.
# REPLAY_WINDOW_START=
# REPLAY_WINDOW_END=
# false keeps a replay out of ledger.csv and learnings.md; trials.csv still
# records it.
REPLAY_WRITE_MEMORY=true

# --- Operations ---
# Where the live ledger, heartbeats, state, reports and agent logs live; ~
# means home. A folder outside the checkout keeps the agents from changing
# tracked files. Run scripts/agents.sh install again after changing it.
DATA_DIR=data
# The trials ledger, the research record. Empty means DATA_DIR/trials.csv;
# data/trials.csv keeps it in the checkout when DATA_DIR is elsewhere.
# TRIALS_FILE=
# Heartbeat name for this run (data/heartbeat/<label>.json); the launchd
# plists set book, watch-flip and watch-sol. Empty means a name built from
# the strategy, interval, execution mode and symbol count.
# RUN_LABEL=
# Run locks (one book scan at a time per broker account, across checkouts).
# Default ~/.cache/trading-harness/locks.
# LOCK_DIR=
# link forces the portable lock-file protocol on macOS too (the ledger
# tests use it); the default there is a kernel lock.
# LOCK_MODE=
# Local dashboard port (npm run dashboard).
DASH_PORT=8787

# --- Alpaca PAPER keys ---
# Needed for stock data, EXECUTION=alpaca-paper, report, reconcile and
# health. Paper keys only: never live keys, never pasted into chat, never
# committed.
# ALPACA_PAPER_KEY_ID=
# ALPACA_PAPER_SECRET=
