# Dependencies and build output
node_modules/
dist/

# Secrets. .env holds the Alpaca paper key id and secret. Never commit it.
# .env.example documents every variable with placeholder values instead.
.env
.env.local
*.key

# Scan and monitor logs. Tens of megabytes, regenerable, and specific to one
# machine's run history. The pre-registration ledger and the trial results in
# data/*.csv are the actual research record and ARE tracked.
*.log
data/*.log

# OS noise
.DS_Store

# Runtime files the agents and reports write: per-agent heartbeats, lock files,
# the perf report, rotated logs and the ledger backups reconcile makes first.
# The live book keeps these in DATA_DIR outside the checkout; these lines
# cover a checkout that runs with the default data/.
data/heartbeat/
data/heartbeat.json
data/risk_state.json
data/perf.json
data/health_state.json
data/logs-archive/
data/backups/
data/.*.lock
data/*.tmp
